# =====================================================================
# Firebase Configuration for AttendoSchool HRMS
# =====================================================================
# To connect to your real Firebase project:
# 1. Copy this file to 'frontend/.env.local' (or replace 'frontend/.env')
# 2. Set VITE_USE_EMULATOR=false
# 3. Paste the configuration values from your Firebase Console
#    (Firebase Console -> Project Settings -> General -> Your Apps -> Web App)
# =====================================================================

VITE_USE_EMULATOR=false
VITE_USE_AUTH_EMULATOR=false

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional reCAPTCHA v3 Site Key for App Check (if enabled)
# VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
